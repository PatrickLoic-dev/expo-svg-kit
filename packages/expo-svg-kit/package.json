{
  "name": "expo-svg-kit",
  "version": "0.1.0",
  "description": "Typed SVG registry and themeable <Icon/> renderer for Expo / React Native",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "source": "src/index.ts",
  "bin": {
    "svg-kit": "bin/svg-kit.js"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "!**/__tests__",
    "!**/__fixtures__"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "dependencies": {
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "svg-path-properties": "^2.2.0",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-svg": "^15.16.0",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "~5.9.3",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.13",
    "@testing-library/react-native": "^14.1.0",
    "react-test-renderer": "19.3.1",
    "@types/react": "^19.1.0",
    "babel-preset-expo": "^58.0.22",
    "expo": "^58.0.21",
    "expo-modules-core": "^58.0.28"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
